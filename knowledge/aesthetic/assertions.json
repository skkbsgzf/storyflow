      "dim": "hook",
      "level": "block",
      "rule": "前 3 秒 / 首 100 字出现四型钩子（悬念/反常/危险/承诺）之一的具体事件；氛围铺垫、世界观说明、人物自介判 block",
      "target": "每集首拍"
    },
    {
      "id": "AE-HOOK-BREVITY",
      "dim": "hook",
      "level": "minor",
      "rule": "钩子 15 字内可复述",
      "target": "每集首拍"
    },
    {
      "id": "AE-HOOK-SOURCE",
      "dim": "hook",
      "level": "major",
      "rule": "钩子与核心冲突同源；支线悬念判 major",
