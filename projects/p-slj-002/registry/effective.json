      "minitool": "kb_search",
      "asserts": [
        "AE-REPORT-DENSITY"
      ],
      "config": {
        "maxChars": "@default:maxChars",
        "minTropeRows": "@default:minTropeRows"
      },
      "desc": "选题模块唯一交付工具：输入灵感 → 选题报告（梗选型+竞品对标+结构解剖+可用话题）。输入职责=灵感；输出职责=选题报告单件；验收职责=AE-REPORT-DENSITY"
    },
    "m2.script-forge": {
      "kind": "agent",
      "title": "剧本师",
      "stage": "m2",
      "module": "m2",
      "kit": "plot",
      "op": "script-forge",
      "output": "02-编剧/剧本.md",
      "skill": "script-forge",
      "asserts": [
        "AE-SCRIPT-FIELDS"
      ],
      "config": {
        "minScenes": "@default:minScenes",
        "maxChars": "@default:maxChars"
      },
      "desc": "编剧模块唯一交付工具：输入选题报告 → 结构化剧本 IR（逐场 5W1H/行动/台词/价值/钩 + 人物卡 + 伏笔登记）。输入职责=选题报告；输出职责=剧本单件；验收职责=AE-SCRIPT-FIELDS"
    },
    "m2.link": {
      "kind": "gate",
      "gate_role": "link",
      "link_mode": "auto",
      "title": "连接 · 编剧（自动批准）",
      "stage": "m2",
      "module": "m2"
    },
    "m3.scene-breakdown": {
      "kind": "agent",
      "title": "小纲师·分镜脚本",
      "stage": "m3",
      "module": "m3",
      "kit": "drama",
      "op": "scene-breakdown",
      "output": "03-成剧/分镜剧本.md",
      "skill": "scene-breakdown",
      "asserts": [
        "AE-BEAT-FORMAT",
        "AE-VIS-EMPTY",
        "AE-HOOK-EVENT"
      ],
      "config": {
        "shotsPerScene": "@default:shotsPerScene",
        "dialogLevel": "@default:dialogLevel"
      },
      "desc": "剧本 IR → 逐集 B拍分镜剧本（第X集/拍号｜钩型｜秒/分镜/台词/表演/尾钩），短剧模块唯一交付件"
    },
    "m3.link": {
      "kind": "gate",
      "gate_role": "link",
      "link_mode": "auto",
      "title": "连接 · 成剧（自动批准）",
      "stage": "m3",
      "module": "m3"
    },
    "m4.export-doc": {
