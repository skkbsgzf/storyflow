      "id": "m1",
      "module": "topic",
      "name": "选题",
      "order": 1,
      "dir": "01-选题",
      "link": "auto",
      "caps": [
        "找梗",
        "素材解剖",
        "时代情绪锚",
        "网感文案",
        "拆书入库",
        "选题报告"
      ],
      "capsEnabled": [
        "选题报告"
      ],
      "spine": [
        "m1.topic-report"
      ],
      "plugins": [],
      "nodes": [
        "m1.topic-report"
      ],
      "io": {
        "input": {
          "from": "flow-input",
          "shape": "一个灵感（点子/命题/素材，任一形态）"
        },
        "output": {
          "file": "选题报告.md",
          "audience": "作者（选题决策文档，兼作编剧模块唯一输入）"
        },
        "acceptance": {
          "asserts": [
            "AE-REPORT-DENSITY"
          ]
        }
      }
    },
    {
      "id": "m2",
      "module": "plot",
      "name": "编剧",
      "order": 2,
      "dir": "02-编剧",
      "link": "auto",
      "caps": [
        "结构",
        "主线",
        "人设",
        "分场",
        "世界观",
        "单元剧大纲",
        "短剧节拍",
        "暗线",
        "伏笔",
        "悬念",
        "红队评审",
        "编剧"
      ],
      "capsEnabled": [
        "编剧"
      ],
      "spine": [
        "m2.script-forge"
      ],
      "plugins": [],
      "nodes": [
        "m2.script-forge"
      ],
      "io": {
        "input": {
          "from": "topic",
          "shape": "选题报告（梗选型+竞品对标+结构手法+可用话题）"
        },
        "output": {
          "file": "剧本.md",
          "audience": "写手（正文模块唯一输入；5W1H 结构化剧本 IR）"
        },
        "acceptance": {
          "asserts": [
            "AE-SCRIPT-FIELDS"
          ]
        }
      }
    },
    {
      "id": "m3",
      "module": "drama",
      "name": "成剧",
      "order": 3,
      "dir": "03-成剧",
      "link": "auto",
      "caps": [
        "分集分镜"
      ],
      "capsEnabled": [
        "分集分镜"
      ],
      "spine": [
        "m3.scene-breakdown"
      ],
      "plugins": [],
      "nodes": [
        "m3.scene-breakdown"
      ],
      "io": {
        "input": {
          "from": "plot",
          "shape": "剧本 IR（逐场 5W/行动/台词/价值/钩 + 伏笔登记）"
        },
        "output": {
          "file": "分镜剧本.md",
          "audience": "导演/制片（可拍摄分镜，导出可批注 docx）"
        },
        "acceptance": {
          "asserts": [
            "AE-BEAT-FORMAT",
            "AE-VIS-EMPTY",
            "AE-HOOK-EVENT"
          ]
        }
      }
