      "desc": "成文流水线末环——把台词/场景/设定三层稿按节拍拼装成正文：逐段六维盖章（台词/场景/设定/人设/节奏/机味），全过才下推；产出正文+盖章单。无分场卡不开工。"
    },
    "m3.ghostwrite": {
      "kind": "agent",
      "title": "文学化师",
      "stage": "m3",
      "module": "m3",
