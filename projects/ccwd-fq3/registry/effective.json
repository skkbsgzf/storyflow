      "title": "export-doc.py",
      "stage": "m4",
      "module": "m4",
      "kit": "delivery",
      "op": "export-doc",
      "output": "04-交付/export-doc.docx",
      "script": "tools/export-doc.py",
      "config": {
        "style": "@default:style",
        "verify": "@default:verify",
        "outDir": "@default:outDir"
      },
      "desc": "export-doc · 小纲/剧本 → Word doc 导出器（export_doc minitool 实现）"
    },
    "m4.link": {
