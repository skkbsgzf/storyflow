    "m1.topic-report": {
      "kind": "agent",
      "title": "选题报告师",
      "stage": "m1",
      "module": "m1",
      "kit": "topic",
      "op": "topic-report",
      "output": "01-选题/选题报告.md",
      "skill": "topic-report",
      "minitool": "kb_search",
      "asserts": [
        "AE-REPORT-DENSITY"
      ],
      "config": {
        "maxChars": "@default:maxChars",
        "minTropeRows": "@default:minTropeRows"
      },
      "desc": "选题模块唯一交付工具：输入灵感 → 选题报告（梗选型+竞品对标+结构解剖+可用话题）。输入职责=灵感；输出职责=选题报告单件；验收职责=AE-REPORT-DENSITY"
    },
    "m2.script-forge": {
      "kind": "agent",
      "title": "剧本师",
      "stage": "m2",
      "module": "m2",
      "kit": "plot",
      "op": "script-forge",
      "output": "02-编剧/剧本.md",
      "skill": "script-forge",
      "asserts": [
        "AE-SCRIPT-FIELDS"
      ],
      "config": {
        "minScenes": "@default:minScenes",
        "maxChars": "@default:maxChars"
      },
      "desc": "编剧模块唯一交付工具：输入选题报告 → 结构化剧本 IR（逐场 5W1H/行动/台词/价值/钩 + 人物卡 + 伏笔登记）。输入职责=选题报告；输出职责=剧本单件；验收职责=AE-SCRIPT-FIELDS"
    },
    "m2.link": {
      "kind": "gate",
      "gate_role": "link",
      "link_mode": "manual",
      "title": "连接 · 编剧（待人工批准）",
      "stage": "m2",
      "module": "m2"
    },
    "m3.ghostwrite": {
      "kind": "agent",
      "title": "文学化师",
      "stage": "m3",
      "module": "m3",
      "kit": "prose",
      "op": "ghostwrite",
      "output": "03-写作/正文.md",
      "skill": "ghostwrite",
      "config": {
        "chapterMin": "@default:chapterMin",
        "chapterMax": "@default:chapterMax"
      },
      "desc": "写作模块主交付工具：输入剧本 → 逐场文学化为正文（六维盖章自查/章末钩/纯净度）。输入职责=剧本；输出职责=正文单件；验收职责=既有 prose 断言表（章长/钩/纯度/台账）"
    },
    "m3.novel-deai": {
      "kind": "agent",
      "title": "novel-deai",
      "stage": "m3",
      "module": "m3",
      "kit": "prose",
      "op": "novel-deai",
      "output": "03-写作/终稿.md",
      "skill": "novel-deai",
      "minitool": "check_aesthetic_asserts",
      "config": {
        "passes": "@default:passes",
        "innerLoops": "@default:innerLoops",
        "coverageLaw": "@default:coverageLaw",
        "metaphorBudget": "@default:metaphorBudget"
      },
      "desc": "快餐网文终稿打磨技能——四遍法打磨（声口校准→处境校准→比喻意象→节奏去机味）+ 多轮精修内环（评审官判分→定向修订→防劣化收敛），诊断先行、覆盖律硬门槛、盲读内环验收；产出可发布终稿与全套收据。"
    },
    "m3.link": {
      "kind": "gate",
      "gate_role": "link",
      "link_mode": "auto",
      "title": "连接 · 写作（自动批准）",
      "stage": "m3",
      "module": "m3"
    },
    "m4.export-doc": {
