{
  "format": "mine-package@1",
  "projectId": "p-fq-001",
  "flowId": "novel-fanqie",
  "flowTitle": "番茄快餐网文工作流 v2（单元剧标准：发散选题 → 世界观底座 → 轻量大纲 → 成稿·去AI味）",
  "version": "2.2.1",
  "runId": "run-mu3kjmhg-coltmb",
  "policy": {
    "kit_boundary": "always",
    "gate_mode": "auto",
    "adapt": "propose"
  },
  "boundaries": [
    "itb-bible",
    "itb-chapter"
  ],
  "nodes": {
    "src": {
      "kind": "novel-txt",
      "title": "选题素材",
      "output": "选题素材.md"
    },
    "market": {
      "kind": "core",
      "title": "市场快照装载"
    },
    "tropes": {
      "kind": "agent",
      "kit": "search",
      "op": "find-trope",
      "title": "找梗选梗（发散）",
      "output": "内部/稿本/梗卡.md"
    },
    "combo": {
      "kind": "core",
      "title": "梗组合相性校验"
    },
    "zeitgeist": {
      "kind": "agent",
      "kit": "search",
      "op": "material-dissect",
      "title": "素材解剖聚合",
      "output": "内部/稿本/热点素材.md"
    },
    "benchmark": {
      "kind": "core",
      "title": "竞品对标装载"
    },
    "analysis": {
      "kind": "agent",
      "kit": "search",
      "op": "topic-analysis-report",
      "title": "选题报告（发散聚合）",
      "output": "对外交付/01-选题报告.md"
    },
    "gate-r1": {
      "kind": "gate",
      "kit": "plot",
      "op": "plot-redline",
      "title": "R1 · 选题验收（用户定种子与主次）",
      "output": "内部/意见/多视角意见书-gate-r1.md"
    },
    "bible": {
      "kind": "agent",
      "kit": "plot",
      "op": "world-forge",
      "title": "世界观锻造（底座·暗线先行）",
      "output": "世界书/世界观圣经.md"
    },
    "red-s2": {
      "kind": "agent",
      "kit": "plot",
      "op": "plot-redline",
      "title": "红方复核·世界观",
      "output": "内部/意见/多视角意见书-red-s2.md"
    },
    "outline3": {
      "kind": "agent",
      "kit": "plot",
      "op": "episodic-outline",
      "title": "单元剧大纲（轻量）",
      "output": "内部/稿本/单元剧大纲.md"
    },
    "red-s3": {
      "kind": "agent",
      "kit": "plot",
      "op": "plot-redline",
      "title": "红方复核·大纲",
      "output": "内部/意见/多视角意见书-red-s3.md"
    },
    "audit": {
      "kind": "core",
      "title": "断言校验（三章）"
    },
    "polish": {
      "kind": "agent",
      "kit": "prose",
      "op": "novel-deai",
      "title": "去AI味终稿打磨",
      "output": "对外交付/02-前三章终稿.md"
    },
    "gate-final": {
      "kind": "gate",
      "kit": "plot",
      "op": "plot-redline",
      "title": "终稿验收（用户读三章）",
      "output": "内部/意见/多视角意见书-gate-final.md"
    },
    "chapter": {
      "kind": "agent",
      "kit": "prose",
      "op": "novel-chapter",
      "title": "章节成稿",
      "output": "章节正文/第1章.md"
    },
    "itb-bible": {
      "kind": "gate",
      "title": "跨域交接验收：search → plot"
    },
    "itb-chapter": {
      "kind": "gate",
      "title": "跨域交接验收：plot → prose"
    }
  },
