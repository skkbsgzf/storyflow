        "AE-CONT-FORESHADOW",
        "AE-CONT-ITEM",
        "AE-CONT-KNOW",
        "AE-DENSITY-CALM",
        "AE-DENSITY-HOT",
        "AE-HOOK-EVENT",
        "AE-VIS-EMPTY"
      ],
      "config": {
        "hookWindowSec": "@default:hookWindowSec",
        "paywallCard": "@default:paywallCard",
        "shotNotation": "@default:shotNotation"
