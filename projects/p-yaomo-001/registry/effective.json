  "nodes": {
    "m1.topic-report": {
      "kind": "agent",
      "title": "选题报告师",
      "stage": "m1",
      "module": "m1",
      "kit": "topic",
      "op": "topic-report",
      "output": "01-选题/选题报告.md",
      "skill": "topic-report",
      "minitool": "kb_search",
      "asserts": [
        "AE-REPORT-DENSITY"
      ],
      "config": {
        "maxChars": "@default:maxChars",
        "minTropeRows": "@default:minTropeRows"
      },
      "desc": "选题模块唯一交付工具：输入灵感 → 选题报告（梗选型+竞品对标+结构解剖+可用话题）。输入职责=灵感；输出职责=选题报告单件；验收职责=AE-REPORT-DENSITY"
    },
    "m1.find-trope": {
      "kind": "agent",
      "title": "find-trope",
      "stage": "m1",
      "module": "m1",
      "kit": "topic",
      "op": "find-trope",
      "output": "01-选题/find-trope.md",
      "skill": "find-trope",
      "minitool": "kb_search",
      "config": {
        "mainTropes": "@default:mainTropes",
        "subTropes": "@default:subTropes",
        "saturationCheck": "@default:saturationCheck",
        "evolutionDepth": "@default:evolutionDepth"
      },
      "desc": "找梗技能——从市场梗库检索梗族、判定饱和度、选主梗辅梗、沿演化链找新变体落点；梗卡是选题方案的前置件。"
    },
    "m1.material-dissect": {
      "kind": "agent",
      "title": "material-dissect",
      "stage": "m1",
      "module": "m1",
      "kit": "topic",
      "op": "material-dissect",
      "output": "01-选题/material-dissect.md",
      "skill": "material-dissect",
      "config": {
        "layers": "@default:layers",
        "inversionCount": "@default:inversionCount",
        "placement": "@default:placement"
      },
      "desc": "选题素材解剖技能——申论式四层剥离（现象/利益/权力/结构），把热点事件聚合成关系结构与权力不对称，从关系逆位生成爽点候选，产出材料落位表。素材不解剖=假材料，梗不落位=装饰品。"
    },
    "m1.deconstruct-book": {
      "kind": "agent",
      "title": "deconstruct-book",
      "stage": "m1",
      "module": "m1",
      "kit": "topic",
      "op": "deconstruct-book",
      "output": "01-选题/deconstruct-book.md",
      "skill": "deconstruct-book",
      "minitool": "kb_search",
      "config": {
        "slots": "@default:slots",
        "variableReplace": "@default:variableReplace",
        "traceability": "@default:traceability"
      },
      "desc": "拆书技能——按拆书总协议把参考作品拆成六槽位可入库素材（梗/人设/剧情设计/导语/细化/片段），产出带替换变量与使用条件的 KB 候选条目；溯源纪律全程硬约束。"
    },
    "m1.topic-zeitgeist": {
      "kind": "agent",
      "title": "时代情绪锚",
      "stage": "m1",
      "module": "m1",
      "kit": "topic",
      "op": "topic-zeitgeist",
      "output": "01-选题/topic-zeitgeist.md",
      "skill": "topic-zeitgeist",
      "config": {
        "windowDays": "@default:windowDays",
        "evidenceCount": "@default:evidenceCount",
        "emotionAnchors": "@default:emotionAnchors"
      },
      "desc": "主旋律与实时性技能——选题必须锚定一个近 30 天可举证的社会情绪，故事是该情绪的具象化；无锚点的选题是经典母题复读，缺共鸣乘数。"
    },
    "m1.internet-feel": {
      "kind": "agent",
      "title": "internet-feel",
      "stage": "m1",
      "module": "m1",
      "kit": "topic",
      "op": "internet-feel",
      "output": "01-选题/internet-feel.md",
      "skill": "internet-feel",
      "minitool": "check_aesthetic_asserts",
      "config": {
        "titleCount": "@default:titleCount",
        "formulaDeck": "@default:formulaDeck",
        "templateCheck": "@default:templateCheck"
      },
      "desc": "网感技能——按市场公式产标题、一句话卖点、共情点与所有对外文案；每个字都在传递钩子或爽点，产出过 24 类去模板化自检。"
    },
    "m2.world-forge": {
      "kind": "agent",
      "title": "world-forge",
      "stage": "m2",
      "module": "m2",
      "kit": "plot",
      "op": "world-forge",
      "output": "02-编剧/world-forge.md",
      "skill": "world-forge",
      "config": {
        "factionCount": "@default:factionCount",
        "powerCost": "@default:powerCost",
        "wikiEntries": "@default:wikiEntries"
      },
      "desc": "网文开书技能（单元剧标准）——选题后先搞世界观：力量体系/势力矛盾/主角力量来源与代价/世界规则四件套；产出世界观圣经（人读）+ wiki 词条库（RAG，index.json+条目交叉链接）；人物动机从世界观长出来，不硬安。"
    },
    "m2.structure-design": {
      "kind": "agent",
      "title": "structure-design",
      "stage": "m2",
      "module": "m2",
      "kit": "plot",
      "op": "structure-design",
      "output": "02-编剧/structure-design.md",
      "skill": "structure-design",
      "minitool": "kb_search",
      "config": {
        "fuseCount": "@default:fuseCount",
        "injectUncertainty": "@default:injectUncertainty",
        "steps": "@default:steps"
      },
      "desc": "第二阶段技能——从结构目录选型并完成深挖/改造/融合三步，产出故事框架案（结构选型理由+骨架具体化+改造点+不确定因素注入提案），确保节奏对齐市场实盘。"
    },
    "m2.plot-choreographer": {
      "kind": "agent",
      "title": "plot-choreographer",
      "stage": "m2",
      "module": "m2",
      "kit": "plot",
      "op": "plot-choreographer",
      "output": "02-编剧/plot-choreographer.md",
      "skill": "plot-choreographer",
      "minitool": "check_aesthetic_asserts",
      "asserts": [
        "AE-CURVE-STALL",
        "AE-CURVE-TYPE",
        "AE-CUSHION",
        "AE-DESERT",
        "AE-END-MECH",
        "AE-REV-MIDPOINT",
        "AE-REV-SETUP"
      ],
      "config": {
        "actModel": "@default:actModel",
        "cardDensity": "@default:cardDensity",
        "dataAnchor": "@default:dataAnchor",
        "lineCount": "@default:lineCount"
      },
      "desc": "剧情编排技能——把八段式策划案升级为可拍的三线骨架×分集功能表×卡点编排表；数据骨架（市场实盘）与美学标准（kb/aesthetic）双驱动。"
    },
    "m2.subplot-weave": {
      "kind": "agent",
      "title": "暗线编织",
      "stage": "m2",
      "module": "m2",
      "kit": "plot",
      "op": "subplot-weave",
      "output": "02-编剧/subplot-weave.md",
      "skill": "subplot-weave",
      "minitool": "check_aesthetic_asserts",
      "knowledge": [
        "kb/structure/episodic-webnovel",
        "kb/aesthetic/emotion-curve",
        "kb/aesthetic/reversal",
        "kb/craft/highlight-loop"
      ],
      "config": {
        "weaveDensity": "@default:weaveDensity",
        "revealCurve": "@default:revealCurve"
      },
      "desc": "暗线编织技能——在主骨架之上叠加第二条叙事线（身份线/复仇线/情感线）：暗线锚点表（每锚点=明线事件+暗线推进量）、双轨咬合检查（暗线停摆=空转）、揭示节奏规划（铺垫→半揭→反转→兑现）；暗线只在编剧层锁定，成文层无权改戏。"
    },
    "m2.foreshadow-plant": {
      "kind": "agent",
      "title": "伏笔悬念插入",
      "stage": "m2",
      "module": "m2",
      "kit": "plot",
      "op": "foreshadow-plant",
      "output": "02-编剧/foreshadow-plant.md",
      "skill": "foreshadow-plant",
      "minitool": "continuity_commit",
      "asserts": [
        "AE-CONT-FORESHADOW"
      ],
      "config": {
        "plantPerUnit": "@default:plantPerUnit",
        "disguiseLevel": "@default:disguiseLevel"
      },
      "desc": "伏笔悬念插入技能——按伏笔台账在指定结构位点埋设伏笔（明面日常化伪装+暗面台账登记：埋设章/预期回收章/知情范围），产出伏笔点位表；埋设必须登记台账、到期必须回收（AE-CONT-FORESHADOW），不埋无回收主的死伏笔。"
    },
    "m2.scene-breakdown": {
      "kind": "agent",
      "title": "scene-breakdown",
      "stage": "m2",
      "module": "m2",
      "kit": "plot",
      "op": "scene-breakdown",
      "output": "02-编剧/scene-breakdown.md",
      "skill": "scene-breakdown",
      "minitool": "check_aesthetic_asserts",
      "config": {
        "shotsPerScene": "@default:shotsPerScene",
        "includeRationale": "@default:includeRationale",
        "dialogLevel": "@default:dialogLevel"
      },
      "desc": "小纲阶段技能——把大纲拆成逐分镜的脚本 doc：每个分镜的场景/人物行动/台词，达意即可无需打磨；文末附创作思路页。输出 doc 格式供客户批注修改后回传。"
    },
    "m2.script-drama-beat": {
      "kind": "agent",
      "title": "短剧节拍表",
      "stage": "m2",
      "module": "m2",
      "kit": "plot",
      "op": "script-drama-beat",
      "output": "02-编剧/script-drama-beat.md",
      "skill": "script-drama-beat",
