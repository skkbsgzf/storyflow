    "id": "outline-production",
    "title": "分集大纲与编排工作流（初稿）",
    "desc": "已过验收的选题方案 → 三线骨架与分集功能表（60 集）→ 红队冷读者测试（节点可预测死点）→ 人工验收 → 可拍分集大纲",
    "version": "0.1.0-draft",
    "status": "draft",
    "upstream": "topic-selection v3（取其选题方案/梗卡/约束移交单产物为输入）",
    "inputs": {
      "project": {
        "type": "project",
        "required": true,
        "desc": "项目上下文"
      },
      "route": {
        "type": "enum",
        "default": "dual",
        "options": [
          "hot",
          "calm",
          "dual"
        ],
        "desc": "沿用选题阶段路线"
      },
      "episodes": {
        "type": "number",
        "default": 60,
        "min": 24,
        "max": 100,
        "bind": {
          "edge": "e-choreo",
          "param": "episodes"
        },
        "desc": "总集数（默认实盘值 60）"
      }
    },
    "outputs": [
      {
        "node": "choreo",
        "title": "分集大纲（逐集：功能/三线状态/关键选择/集末钩）"
      },
      {
        "node": "redline",
        "title": "红方意见书（大纲级冷读者测试）"
      }
    ],
    "graph": {
      "format": "smwf@2",
      "name": "outline-production",
      "nodes": {
        "src": {
          "kind": "novel-txt",
          "title": "选题方案（已验收）",
          "output": "选题方案.md"
        },
        "constraints": {
          "kind": "core",
          "title": "约束与标准装载",
          "minitool": "kb_load",
          "loads": [
            "kb/market/constraints",
            "kb/aesthetic/pacing-density",
            "kb/aesthetic/reversal",
            "kb/aesthetic/emotion-curve",
            "kb/aesthetic/scene-value",
            "kb/aesthetic/ending"
          ]
        },
