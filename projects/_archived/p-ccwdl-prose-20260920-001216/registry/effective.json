          "output": "分场卡.md"
        },
        "ledger": {
          "kind": "core",
          "title": "台账切片",
          "minitool": "continuity_slice",
          "desc": "从连续性台账切出本批章的知情范围/在场物品/到期伏笔，注入节拍卡与设定官"
        },
        "beats": {
          "kind": "agent",
          "title": "分场锻拍",
          "skill": "scene-breakdown",
          "kit": "plot",
          "op": "scene-breakdown",
          "output": "内部/稿本/成文节拍卡.md",
          "desc": "分场小纲锻成五行卡节拍（每章 3-6 拍：地点/在场人物/冲突或事件/情绪值走向/拍末钩）——剧情在此锁定，成文层无权改戏，发现问题回打本卡"
        },
        "voices": {
          "kind": "agent",
          "title": "台词师",
          "skill": "layer-voices",
          "kit": "prose",
          "op": "layer-voices",
