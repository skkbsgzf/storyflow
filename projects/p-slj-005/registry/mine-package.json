{
  "format": "mine-package@1",
  "projectId": "p-slj-005",
  "flowId": "drama-flow",
  "flowTitle": "短剧流 v1（模块化）",
  "version": "1.1.0",
  "runId": "run-mu8iwrwt-1nu6lt",
  "policy": {
    "link_default": "auto",
    "adapt": "propose"
  },
  "boundaries": [],
  "nodes": {
    "m1.topic-report": {
      "kind": "agent",
      "kit": "topic",
      "op": "topic-report",
      "title": "选题报告师",
      "output": "01-选题/选题报告.md",
      "config": {
        "maxChars": "@default:maxChars",
        "minTropeRows": "@default:minTropeRows"
      }
    },
    "m2.structure-design": {
      "kind": "agent",
      "kit": "plot",
      "op": "structure-design",
      "title": "structure-design",
      "output": "02-编剧/structure-design.md",
      "config": {
        "fuseCount": "@default:fuseCount",
        "injectUncertainty": "@default:injectUncertainty",
        "steps": "@default:steps"
      }
    },
    "m2.plot-choreographer": {
      "kind": "agent",
      "kit": "plot",
      "op": "plot-choreographer",
      "title": "plot-choreographer",
      "output": "02-编剧/plot-choreographer.md",
      "config": {
        "actModel": "@default:actModel",
        "cardDensity": "@default:cardDensity",
        "dataAnchor": "@default:dataAnchor",
        "lineCount": "@default:lineCount"
      }
    },
    "m2.foreshadow-plant": {
      "kind": "agent",
      "kit": "plot",
      "op": "foreshadow-plant",
      "title": "伏笔悬念插入",
      "output": "02-编剧/foreshadow-plant.md",
      "config": {
        "plantPerUnit": "@default:plantPerUnit",
        "disguiseLevel": "@default:disguiseLevel"
      }
    },
    "m2.scene-breakdown": {
      "kind": "agent",
      "kit": "plot",
      "op": "scene-breakdown",
      "title": "scene-breakdown",
      "output": "02-编剧/scene-breakdown.md",
      "config": {
        "shotsPerScene": "@default:shotsPerScene",
        "includeRationale": "@default:includeRationale",
        "dialogLevel": "@default:dialogLevel"
      }
    },
    "m2.script-drama-beat": {
      "kind": "agent",
      "kit": "plot",
      "op": "script-drama-beat",
      "title": "短剧节拍表",
      "output": "02-编剧/script-drama-beat.md",
      "config": {
        "hookWindowSec": "@default:hookWindowSec",
        "paywallCard": "@default:paywallCard",
        "shotNotation": "@default:shotNotation"
      }
    },
    "m2.plot-redline": {
      "kind": "agent",
      "kit": "plot",
      "op": "plot-redline",
      "title": "剧情红队·多方视角评审",
      "output": "02-编剧/plot-redline.md",
      "config": {
        "angles": "@default:angles",
        "harshness": "@default:harshness",
        "allowInject": "@default:allowInject",
        "voice": "@default:voice"
      }
    },
    "m2.script-forge": {
      "kind": "agent",
      "kit": "plot",
      "op": "script-forge",
      "title": "剧本师",
      "output": "02-编剧/剧本.md",
      "config": {
        "minScenes": "@default:minScenes",
        "maxChars": "@default:maxChars"
      }
    },
    "m2.link": {
      "kind": "gate",
      "title": "连接 · 编剧（自动批准）"
    },
    "m3.scene-breakdown": {
      "kind": "agent",
      "kit": "drama",
      "op": "scene-breakdown",
      "title": "小纲师·分镜脚本",
      "output": "03-成剧/分镜剧本.md",
      "config": {
        "shotsPerScene": "@default:shotsPerScene",
        "dialogLevel": "@default:dialogLevel"
      }
    },
    "m3.link": {
      "kind": "gate",
      "title": "连接 · 成剧（自动批准）"
    }
  },
