          "output": "内部/收据/连续性台账.json"
        },
        "write": {
          "kind": "agent",
          "title": "分拍写作",
          "skill": "script-drama-beat",
          "kit": "plot",
          "op": "script-drama-beat",
          "output": "内部/稿本/剧本-第XX集.md",
          "desc": "单集 600-900 字硬格式；前 3 秒钩子；△动作可拍摄；集末卡点体检；route 档位参数生效（hot：零时差/爆点密度；calm：9:1 浓度）"
        },
        "audit": {
          "kind": "core",
          "title": "断言+台账双校验",
          "minitool": "check_aesthetic_asserts",
          "asserts": [
