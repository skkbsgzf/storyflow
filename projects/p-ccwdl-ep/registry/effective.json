            "AE-DENSITY-HOT",
            "AE-DENSITY-CALM",
            "AE-CARD-END",
            "AE-BEAT-FORMAT",
            "AE-VIS-EMPTY",
            "AE-CONT-KNOW",
            "AE-CONT-ITEM",
            "AE-CONT-FORESHADOW"
          ],
          "onFail": "退回 write 定点修（重试记账，不计完成）",
          "desc": "确定性：钩子事件/密度档位/卡点/格式/禁空镜 + 知识越权/台账矛盾/伏笔逾期",
          "output": "内部/收据/硬断言报告.json"
        },
        "ledgerUp": {
          "kind": "core",
          "title": "台账结算",
          "minitool": "continuity_commit",
          "desc": "确定性：校验全过后原子提交正文+台账增量（新增死亡/物品流转/知情变更/新伏笔）；不落状态不收稿"
        },
        "redline": {
          "kind": "agent",
