        "type": "project",
        "required": true,
        "desc": "项目上下文"
      },
      "route": {
        "type": "enum",
        "default": "hot",
        "options": [
          "hot",
          "calm"
        ],
        "desc": "沿用选题阶段路线档位"
      },
      "range": {
        "type": "string",
        "required": true,
        "desc": "集数范围（如 '1-6'，前三集优先）"
      },
      "batch": {
        "type": "number",
        "default": 6,
        "min": 1,
        "max": 12,
        "desc": "单批集数（人工验收批次粒度）"
      }
    },
    "outputs": [
      {
        "node": "ledger",
        "title": "连续性台账（滚动维护）"
      },
      {
        "node": "write",
        "title": "单集剧本（script-drama-beat 硬格式）"
      },
      {
        "node": "audit",
        "title": "逐集硬断言报告（block 项清零才收稿）"
      },
      {
        "node": "redline",
        "title": "红队抽检意见（每批 ≥1 集）"
      }
    ],
