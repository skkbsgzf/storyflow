          "skill": "plot-redline",
          "kit": "plot",
          "op": "plot-redline",
          "spotCheck": true,
          "policy": "每批 ≥1 集（优先爆点集与卡点集）",
          "output": "内部/意见/红方意见书-redline.md",
          "desc": "spot-check 模式：名场面可视化五要素 + 便宜方案检查 + 结构机味指纹"
        },
        "fin": {
          "kind": "srd",
          "title": "批次人工验收",
          "desc": "按批次裁决；连续 2 批全过 → 红队哨兵钝化自检（profile gate_behavior）"
        }
      },
      "edges": [
