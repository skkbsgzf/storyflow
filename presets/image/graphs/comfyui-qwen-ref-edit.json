{
  "$comment": "ComfyUI API 格式图模板 · Qwen-Image 2.1 参考图编辑链（跨格保身份的母版形状，取自 2026-10-11 实测跑通的 panel-edit 图）。两个坑必须记住：① TextEncodeQwenImage21 的 images 槽在 API 格式里必须是**嵌套字典** {\"image_1\":[节点,槽]}，扁平键能过 /prompt 校验但执行期 TypeError；② 该节点第三个输出（slot 2）就是 latent，编辑链要把它同喂 KSampler.latent_image——**不要**再挂 EmptyLatentImage，否则身份漂移。QwenImage21Cache 的 device 出厂钉 off：显存纪律，缓存类节点默认不常驻（画像 engines.node_patch 是它唯一可控的覆写处）。",
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "__UNET__",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "__CLIP__",
      "type": "qwen_image",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "__VAE__"
    }
  },
  "6": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "__REF_1__"
    }
  },
  "4": {
    "class_type": "TextEncodeQwenImage21",
    "inputs": {
      "clip": ["2", 0],
      "vae": ["3", 0],
      "prompt": "__PROMPT__",
      "negative_prompt": "__NEGATIVE__",
      "resolution": "__RESOLUTION__",
      "images": {
        "image_1": ["6", 0]
      }
    }
  },
  "5": {
    "class_type": "QwenImage21Cache",
    "inputs": {
      "model": ["1", 0],
      "device": "off",
      "dtype": "default"
    }
  },
  "7": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["5", 0],
      "positive": ["4", 0],
      "negative": ["4", 1],
      "latent_image": ["4", 2],
      "seed": "__SEED__",
      "steps": "__STEPS__",
      "cfg": "__CFG__",
      "sampler_name": "__SAMPLER__",
      "scheduler": "__SCHEDULER__",
      "denoise": "__DENOISE__"
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["7", 0],
      "vae": ["3", 0]
    }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["8", 0],
      "filename_prefix": "__OUT_PREFIX__"
    }
  }
}
