    "check-purity": {
      "script": "tools/check-purity.py",
      "title": "check-purity.py",
      "desc": "产物正文纯净度检查（AE-OUTPUT-PURITY）。",
      "config": {
        "severityFloor": {
          "type": "enum",
          "default": "block",
          "enum": [
            "warn",
            "block"
