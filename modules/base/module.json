{
  "format": "module@1",
  "id": "base",
  "name": "底座",
  "desc": "确定性底座：断言引擎/连续性台账/脚本工具箱/编排挖掘——零 LLM，被各模块按需调用",
  "version": "0.1.0",
  "ops": {
    "check_trope_combo": {
      "title": "梗组合相性校验",
      "minitools": [
        "check_trope_combo"
      ],
      "desc": "走 check_* integrity 模式：产物存在性/结构完整/断言子集",
      "kind": "produce",
      "config": {
        "mode": {
          "type": "enum",
          "default": "integrity",
          "enum": [
            "integrity",
            "strict"
          ],
          "desc": "检查模式",
          "effect": "strict = 更严，误报上升",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "skipMissing": {
          "type": "boolean",
          "default": false,
          "desc": "缺产物时跳过而非阻断",
          "effect": "开启 = 静默放行风险",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      },
      "capability": [
        "梗相性"
      ]
    },
    "continuity_slice": {
      "title": "台账切片",
      "minitools": [
        "continuity_slice"
      ],
      "desc": "（planned，内核未实现，触达即 blocked）世界书 台账/章账 按章切片供写手",
      "kind": "produce",
      "config": {
        "sliceUnit": {
          "type": "enum",
          "default": "章",
          "enum": [
            "章",
            "拍",
            "场景"
          ],
          "desc": "切片单位",
          "effect": "拍/场景 = 更细更慢",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "lookback": {
          "type": "number",
          "default": 3,
          "min": 0,
          "desc": "回看范围（多少个单位）",
          "effect": "提高 = 更连续也更占预算",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "includeRetired": {
          "type": "boolean",
          "default": false,
          "desc": "是否包含已退役词条",
          "effect": "开启 = 噪声增加",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      },
      "capability": [
        "台账切片"
      ]
    },
    "continuity_commit": {
      "title": "台账结算",
      "minitools": [
        "continuity_commit"
      ],
      "desc": "（planned，内核未实现，触达即 blocked）章回写手待登记清单回写世界书词条（状态机 draft/active/retired）",
      "kind": "produce",
      "config": {
        "stateMachine": {
          "type": "enum",
          "default": "draft/active/retired",
          "enum": [
            "draft/active/retired",
            "自由"
          ],
          "desc": "词条状态机",
          "effect": "自由 = 状态不可枚举",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "requireEvidence": {
          "type": "boolean",
          "default": true,
          "desc": "回写必须带依据",
          "effect": "关掉 = 台账来源不明",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      },
      "capability": [
        "台账结算"
      ]
    },
    "analyze-kakaxing": {
      "script": "tools/analyze-kakaxing.py",
      "title": "analyze-kakaxing.py",
      "desc": "kakaxing 语料分析：题材×热度、八段式策划案解析、句式与梗族挖掘。确定性、零 LLM。",
      "kind": "check",
      "config": {
        "topN": {
          "type": "number",
          "default": 20,
          "min": 0,
          "desc": "题材×热度榜取前 N",
          "effect": "提高 = 样本更全",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "genre": {
          "type": "string",
          "default": "",
          "desc": "限定题材（空=全量）",
          "effect": "限定 = 更快更聚焦",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      },
      "capability": [
        "卡克行分析"
      ]
    },
    "artifact-lint": {
      "script": "tools/artifact-lint.py",
      "title": "artifact-lint.py",
      "desc": "artifact-lint · 过程交付件格式体检（规范 R4 §二/§三/§四）",
      "kind": "check",
      "config": {},
      "capability": [
        "产物准入"
      ]
    },
    "check-purity": {
      "script": "tools/check-purity.py",
      "title": "check-purity.py",
      "desc": "产物正文纯净度检查（AE-OUTPUT-PURITY）。",
      "kind": "check",
      "config": {
        "severityFloor": {
          "type": "enum",
          "default": "block",
          "enum": [
            "warn",
            "block"
          ],
          "desc": "最低阻断级别",
          "effect": "调成 warn = 纯净度只提示",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "allowFrontmatter": {
          "type": "boolean",
          "default": true,
          "desc": "允许 artifact@1 头部",
          "effect": "关掉 = 过程件也会被判污染",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      },
      "capability": [
        "正文纯净"
      ]
    },
    "batch-edit": {
      "script": "tools/batch-edit.py",
      "title": "batch-edit.py",
      "desc": "同文件多处修改的原子批量器：ops.json 字面替换清单一次调用；任一处不成立=整批拒绝零写入，全批成立=单次落盘＋一份 unified diff＋收据。>=3 处散点修订用它，1-2 处仍用 Edit。",
      "kind": "produce",
      "config": {
        "dryRun": {
          "type": "boolean",
          "default": false,
          "desc": "只校验不落盘",
          "effect": "开=预演整批，返回成立/不成立清单",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      },
      "capability": [
        "批量编辑"
      ]
    },
    "flow-lint": {
      "script": "tools/flow-lint.py",
      "title": "flow-lint.py",
      "desc": "flow-lint · flow@2 配置体检（规范 R4 §五/§六）",
      "kind": "check",
      "config": {
        "strict": {
          "type": "boolean",
          "default": false,
          "desc": "warning 也视为失败",
          "effect": "开启 = 更严，可能卡住历史债",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      },
      "capability": [
        "flow工具"
      ]
    },
    "flow-export": {
      "script": "tools/flow-export.py",
      "title": "flow-export.py",
      "desc": "flow-export · 生效编排只读导出适配器（外部 agent/引擎可消费：runbook/mermaid/json；单源经内核 effectiveOf/effectiveFlow3，禁重写派生）",
      "kind": "check",
      "config": {
        "target": {
          "type": "string",
          "default": "runbook",
          "desc": "导出形态：runbook（运行手册 md，自带 mermaid）| mermaid（纯图）| json（中性 JSON）",
          "effect": "runbook 给人/外部 agent 阅，json 给程序消费",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "truncate": {
          "type": "number",
          "default": 80,
          "min": 20,
          "desc": "导出物中长值（输入生效值/边条件）的截断宽度（字符）",
          "effect": "提高 = 更完整但更啰嗦；降低 = 手册更紧凑",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      },
      "capability": [
        "flow工具"
      ]
    },
    "flow-verify": {
      "script": "tools/flow-verify.py",
      "title": "flow-verify.py",
      "desc": "flow-verify.py · 产物脱流改动探测器（K7 · 2026-09-17 事故 R2 落地件）",
      "kind": "check",
      "config": {
        "since": {
          "type": "string",
          "default": "",
          "desc": "只看该时间之后的改动",
          "effect": "缩小 = 更快",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "failOnMissingReceipt": {
          "type": "boolean",
          "default": true,
          "desc": "声明了校验却无收据即失败",
          "effect": "关掉 = 虚报有缝可钻",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      },
      "capability": [
        "flow工具"
      ]
    },
