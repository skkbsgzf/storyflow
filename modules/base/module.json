        "allowFrontmatter": {
          "type": "boolean",
          "default": true,
          "desc": "允许 artifact@1 头部",
          "effect": "关掉 = 过程件也会被判污染",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      },
      "capability": [
        "正文纯净"
      ]
    },
    "flow-kit-apply": {
      "script": "tools/flow-kit-apply.py",
      "title": "flow-kit-apply.py",
      "desc": "flow-kit-apply · flow 节点声明迁移：skill + kb → kit + op（kit@1）",
