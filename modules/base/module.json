{
  "format": "module@1",
  "id": "base",
  "name": "底座",
  "desc": "确定性底座：断言引擎/连续性台账/脚本工具箱/编排挖掘——零 LLM，被各模块按需调用",
  "version": "0.1.0",
  "ops": {
    "check_aesthetic_asserts": {
      "title": "美学硬断言校验",
      "minitools": [
        "check_aesthetic_asserts"
      ],
      "desc": "钩型/三件套/时长/密度/梗点/卡点/合规/编排表忠实性（M2 正式版）",
      "config": {
        "scope": {
          "type": "enum",
          "default": "整批",
          "enum": [
            "单件",
            "整批"
          ],
          "desc": "检查范围",
          "effect": "单件 = 快但漏跨件一致性",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "severityFloor": {
          "type": "enum",
          "default": "block",
          "enum": [
            "warn",
            "block"
          ],
          "desc": "最低阻断级别",
          "effect": "调成 warn = 断言只提示不拦",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "dims": {
          "type": "array",
          "default": [
            "钩型",
            "三件套",
            "时长",
            "密度",
            "梗点",
            "卡点",
            "合规",
            "编排表忠实性"
          ],
          "desc": "参与的维度子集",
          "effect": "减少 = 检查更快、覆盖变窄",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      },
      "capability": [
        "美学断言"
      ]
    },
    "check_trope_combo": {
      "title": "梗组合相性校验",
      "minitools": [
        "check_trope_combo"
      ],
      "desc": "走 check_* integrity 模式：产物存在性/结构完整/断言子集",
      "config": {
        "mode": {
          "type": "enum",
          "default": "integrity",
          "enum": [
            "integrity",
            "strict"
          ],
          "desc": "检查模式",
          "effect": "strict = 更严，误报上升",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "skipMissing": {
          "type": "boolean",
          "default": false,
          "desc": "缺产物时跳过而非阻断",
          "effect": "开启 = 静默放行风险",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      },
      "capability": [
        "梗相性"
      ]
    },
    "continuity_slice": {
      "title": "台账切片",
      "minitools": [
        "continuity_slice"
      ],
      "desc": "（planned，内核未实现，触达即 blocked）世界书 台账/章账 按章切片供写手",
      "config": {
        "sliceUnit": {
          "type": "enum",
          "default": "章",
          "enum": [
            "章",
            "拍",
            "场景"
          ],
          "desc": "切片单位",
          "effect": "拍/场景 = 更细更慢",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "lookback": {
          "type": "number",
          "default": 3,
          "min": 0,
          "desc": "回看范围（多少个单位）",
          "effect": "提高 = 更连续也更占预算",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "includeRetired": {
          "type": "boolean",
          "default": false,
          "desc": "是否包含已退役词条",
          "effect": "开启 = 噪声增加",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      },
      "capability": [
        "台账切片"
      ]
    },
    "continuity_commit": {
      "title": "台账结算",
      "minitools": [
        "continuity_commit"
      ],
      "desc": "（planned，内核未实现，触达即 blocked）章回写手待登记清单回写世界书词条（状态机 draft/active/retired）",
      "config": {
        "stateMachine": {
          "type": "enum",
          "default": "draft/active/retired",
          "enum": [
            "draft/active/retired",
            "自由"
          ],
          "desc": "词条状态机",
          "effect": "自由 = 状态不可枚举",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "requireEvidence": {
          "type": "boolean",
          "default": true,
          "desc": "回写必须带依据",
          "effect": "关掉 = 台账来源不明",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      },
      "capability": [
        "台账结算"
      ]
    },
    "continuity_check": {
      "title": "连续性校验",
      "minitools": [
        "continuity_check"
      ],
      "desc": "（planned，内核未实现，触达即 blocked）台账矛盾/知情范围越权/伏笔逾期——当前由 check_aesthetic_asserts 的 AE-CONT-* 承担，待拆为独立 minitool",
      "config": {
        "dims": {
          "type": "array",
          "default": [
            "矛盾",
            "知情范围",
            "伏笔逾期"
          ],
          "desc": "参与的检查维度",
          "effect": "减少 = 更快但漏检",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "severityFloor": {
          "type": "enum",
          "default": "block",
          "enum": [
            "warn",
            "block"
          ],
          "desc": "最低阻断级别",
          "effect": "调成 warn = 只提示不拦",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      },
      "capability": [
        "连续性校验"
      ]
    },
    "analyze-kakaxing": {
      "script": "tools/analyze-kakaxing.py",
      "title": "analyze-kakaxing.py",
      "desc": "kakaxing 语料分析：题材×热度、八段式策划案解析、句式与梗族挖掘。确定性、零 LLM。",
      "config": {
        "topN": {
          "type": "number",
          "default": 20,
          "min": 0,
          "desc": "题材×热度榜取前 N",
          "effect": "提高 = 样本更全",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "genre": {
          "type": "string",
          "default": "",
          "desc": "限定题材（空=全量）",
          "effect": "限定 = 更快更聚焦",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      },
      "capability": [
        "卡克行分析"
      ]
    },
    "artifact-lint": {
      "script": "tools/artifact-lint.py",
      "title": "artifact-lint.py",
      "desc": "artifact-lint · 过程交付件格式体检（规范 R4 §二/§三/§四）",
      "config": {},
      "capability": [
        "产物准入"
      ]
