{
  "format": "module@1",
  "id": "delivery",
  "name": "交付",
  "desc": "交付域：成品出库——docx 硬断言导出、交付页渲染、客户批注回流解析",
  "version": "0.1.0",
  "ops": {
    "export-doc": {
      "script": "tools/export-doc.py",
      "title": "export-doc.py",
      "desc": "export-doc · 小纲/剧本 → Word doc 导出器（export_doc minitool 实现）",
      "kind": "check",
      "config": {
        "style": {
          "type": "enum",
          "default": "默认",
          "enum": [
            "默认",
            "公文",
            "网文"
          ],
          "desc": "导出模板风格",
          "effect": "换了 = 交付观感变化",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "verify": {
          "type": "boolean",
          "default": true,
          "desc": "导出后计数/残渣硬断言",
          "effect": "关掉 = 交付失败不会被发现",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "outDir": {
          "type": "string",
          "default": "对外交付",
          "desc": "导出目录",
          "effect": "越界路径会被内核拒绝",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      },
      "capability": [
        "docx交付"
      ],
      "also_fits": [],
      "requires": [],
      "adds": {
        "asserts": [],
        "knowledge": [],
        "config": {}
      }
    },
    "render_html": {
      "title": "交付页渲染",
      "minitools": [
        "render_html"
      ],
      "desc": "静态单文件交付页生成",
      "kind": "produce",
      "config": {
        "theme": {
          "type": "enum",
          "default": "纸感",
          "enum": [
            "纸感",
            "暗色",
            "极简"
          ],
          "desc": "交付页主题",
          "effect": "换了 = 交付观感变化",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "maxSections": {
          "type": "number",
          "default": 20,
          "min": 0,
          "desc": "合入的最大产物数",
          "effect": "提高 = 页面更全也更长",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "inlineCss": {
          "type": "boolean",
          "default": true,
          "desc": "样式内联（单文件离线可读）",
          "effect": "关掉 = 离开仓库即掉样式",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      },
      "capability": [
        "交付页"
      ],
      "slot": "end",
      "also_fits": [],
      "requires": [],
      "adds": {
        "asserts": [],
        "knowledge": [],
        "config": {}
      }
    }
  },
  "skeleton": {
    "spine": [
      "export-doc"
    ],
    "edges": []
  },
  "caps": [
    "docx交付",
    "交付页",
    "批注回流"
  ],
  "io": {
    "input": {
      "from": "prose",
      "shape": "正文终稿（每模块一份成熟交付）"
    },
    "output": {
      "file": "export-doc.docx",
      "audience": "编辑/甲方（可批注 docx）"
    },
    "acceptance": {
      "asserts": []
    }
  }
}
