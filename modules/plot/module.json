      "minitools": [
        "kb_search",
        "check_trope_combo"
      ],
      "config": {
        "fuseCount": {
          "type": "number",
          "default": 2,
          "min": 0,
          "desc": "融合的结构数",
          "effect": "提高 = 更独特、可读性风险上升",
          "tunable_by": [
            "user",
            "optimizer"
          ]
