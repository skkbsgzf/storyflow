{
  "format": "module@1",
  "id": "plot",
  "name": "编剧",
  "desc": "编剧域：主线剧情、人设、世界观、暗线、伏笔悬念的编排——剧情在成文前锁定，成文层无权改戏",
  "version": "2.1.0",
  "ops": {
    "adapt-triage": {
      "skill": "adapt-triage",
      "title": "改编反馈诊断",
      "kind": "review",
      "desc": "原稿×甲方反馈对撞，产出 file:line 级病灶账（A结构病/B单集病/C句面病）+ 爽点五类盘点三数（各出现几次/最长空窗/全程缺席哪类）+ 改编取向 + 不改动清单；不做改写，不给「已充分考虑」。",
      "knowledge": [
        "kb/formats/comic-drama-adapt",
        "kb/aesthetic/perspective-review",
        "kb/aesthetic/unreasonable-highlight",
        "kb/method/revision-loop"
      ],
      "minitools": [
        "scan_quality"
      ],
      "config": {
        "maxFindings": {
          "type": "number",
          "default": 5,
          "min": 1,
          "desc": "进手术方案的最差病灶条数",
          "effect": "提高 = 一轮摊得太开，违反「一轮改透三处」",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "thrillAudit": {
          "type": "boolean",
          "default": true,
          "desc": "是否强制产出爽点五类盘点表",
          "effect": "关掉 = 「避重就轻不足」退回主观印象",
          "tunable_by": [
            "user"
          ]
        },
        "harshness": {
          "type": "enum",
          "default": "标准",
          "enum": [
            "温和",
            "标准",
            "苛刻"
          ],
          "desc": "病灶判级尺度",
          "effect": "提高 = 更多立案，也更容易把件改坏",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "keepList": {
          "type": "boolean",
          "default": true,
          "desc": "是否强制产出「不改动清单」",
          "effect": "关掉 = 下游顺手改坏原有好件",
          "tunable_by": [
            "user"
          ]
        }
      },
      "capability": [
        "改编诊断"
      ],
      "slot": "before:structure-design",
      "also_fits": [
        "end"
      ],
      "requires": [],
      "adds": {
        "knowledge": [],
        "config": {}
      }
    },
    "story-outline": {
      "skill": "story-outline",
      "title": "全季故事简纲",
      "kind": "produce",
      "desc": "把改编取向落成全季简纲：脊柱映射（哪一集踩在哪一章）＋与原著的差异清单（逐条带章号与理由）＋节拍分段＋贯穿型压迫装置＋逐节点 STAR 简纲＋曲线对账。只到集区粒度，不写逐集表／分场／台词。",
      "knowledge": [
        "kb/formats/comic-drama-adapt",
        "kb/market/constraints",
        "kb/aesthetic/pacing-density",
        "kb/aesthetic/reversal",
        "kb/aesthetic/emotion-curve"
      ],
      "minitools": [
        "scan_quality"
      ],
      "config": {
        "starGranularity": {
          "type": "enum",
          "default": "集区节点",
          "enum": [
            "集区节点",
            "逐集"
          ],
          "desc": "简纲的下探粒度",
          "effect": "逐集 = 与分集重排表越权重叠，两本账必漂移",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "sourceDiffTable": {
          "type": "boolean",
          "default": true,
          "desc": "是否强制产出「原著 vs 本稿」差异清单",
          "effect": "关掉 = 甲方无从核对是否偷改原著",
          "tunable_by": [
            "user"
          ]
        },
        "pressureDevice": {
          "type": "boolean",
