            "两步",
            "三步"
          ],
          "desc": "深挖/改造/融合的执行粒度",
          "effect": "两步 = 快，三步 = 稳",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      },
      "capability": [
        "结构"
      ],
      "also_fits": [],
      "requires": [],
      "adds": {
        "asserts": [],
        "knowledge": [],
        "config": {}
