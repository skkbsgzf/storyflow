{
  "format": "module@1",
  "id": "plan",
  "name": "方案",
  "desc": "方案域：选题分析报告 → 选题方案成文，附审美终审与需求交付对账两个监管位",
  "version": "0.1.0",
  "ops": {
    "topic-analysis-report": {
      "skill": "topic-analysis-report",
      "title": "选题分析报告方法论",
      "desc": "选题流程·分析报告步的工作规范——消费选题素材包与四视角评估批注，产出市场/目标客群/竞品/数据分析四板块加结论的选题分析报告，并以「创作约束移交单」向编剧步移交硬约束。",
      "kind": "produce",
      "knowledge": [
        "kb/aesthetic/oversight",
        "kb/market/*",
        "kb/structure/episodic-webnovel"
      ],
      "config": {
        "sections": {
          "type": "number",
          "default": 4,
          "min": 0,
          "desc": "报告板块数（市场/客群/竞品/数据）",
          "effect": "减少 = 分析不完整",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "handoffSheet": {
          "type": "boolean",
          "default": true,
          "desc": "输出创作约束移交单",
          "effect": "关掉 = 编剧步没硬约束",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "dataCitations": {
          "type": "number",
          "default": 5,
          "min": 0,
          "desc": "引用数据的条数下限",
          "effect": "降低 = 结论悬浮",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      },
      "capability": [
        "选题分析"
      ],
      "also_fits": [],
      "requires": [],
      "adds": {
        "asserts": [],
        "knowledge": [],
        "config": {}
      }
    },
    "topic-proposal": {
      "skill": "topic-proposal",
      "title": "选题方案方法论",
      "desc": "选题流程·选题方案步的工作规范——纯内容呈现：选题、人设、冲突设计、大纲、前三集初稿；市场结论只以「创作约束移交单」为输入，报告里禁止商业分析语言。",
      "kind": "produce",
      "knowledge": [
        "kb/aesthetic/*",
        "kb/benchmark/*"
      ],
      "config": {
        "outlineDepth": {
          "type": "enum",
          "default": "粗纲",
          "enum": [
            "粗纲",
            "细纲"
          ],
          "desc": "大纲的颗粒度",
          "effect": "细纲 = 更快进入成稿也更贵",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "firstEpisodes": {
          "type": "number",
          "default": 3,
          "min": 0,
          "desc": "前三集初稿的集数",
          "effect": "提高 = 交付更重",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "banBizLanguage": {
          "type": "boolean",
          "default": true,
          "desc": "禁止出现商业分析语言",
          "effect": "关掉 = 方案串味",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      },
      "capability": [
        "选题方案"
      ],
      "also_fits": [],
      "requires": [],
      "adds": {
        "asserts": [],
        "knowledge": [],
        "config": {}
      }
    },
    "topic-chief-aesthetic": {
      "skill": "topic-chief-aesthetic",
      "title": "审美总编·选题方案质量观",
      "desc": "审美总编技能（监管位）——以对标已出品爆款为强度标尺，对选题方案做爆点强度/钩子冲击力/名场面可视化三维把控；写入方案即视为总编终审通过。",
      "kind": "produce",
      "config": {
        "benchmark": {
          "type": "enum",
          "default": "对标爆款",
          "enum": [
            "对标爆款",
            "内部标准"
          ],
          "desc": "强度标尺来源",
          "effect": "内部标准 = 与市场脱节",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "dims": {
          "type": "number",
          "default": 3,
          "min": 0,
          "desc": "把控维度数（爆点强度/钩子冲击力/名场面可视化）",
          "effect": "减少 = 把控漏面",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "writeInto": {
          "type": "boolean",
          "default": true,
          "desc": "把控结论直接写入方案（视为终审通过）",
          "effect": "关掉 = 把控意见游离在方案外",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      },
      "capability": [
        "审美终审"
      ],
      "slot": "after:topic-proposal",
      "also_fits": [
        "after:topic-analysis-report"
      ],
      "requires": [
        "topic-proposal"
      ],
      "adds": {
        "asserts": [],
        "knowledge": [],
        "config": {}
      }
    },
    "topic-delivery-gate": {
      "skill": "topic-delivery-gate",
      "title": "需求交付·对账清单",
      "desc": "需求交付技能（监管位）——对分析报告「创作约束移交单」逐条合规对账 + 交付完整性核查；硬条款违反一票否决，合同优先于审美。",
      "kind": "produce",
      "config": {
        "checklist": {
          "type": "enum",
          "default": "逐条对账",
          "enum": [
            "逐条对账",
            "抽样"
          ],
          "desc": "对「创作约束移交单」的核查方式",
          "effect": "抽样 = 硬条款可能漏",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "vetoHard": {
          "type": "boolean",
          "default": true,
          "desc": "硬条款违反一票否决",
          "effect": "关掉 = 合同风险自担",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      },
      "capability": [
        "交付对账"
      ],
      "slot": "end",
      "also_fits": [],
      "requires": [
        "topic-analysis-report"
      ],
      "adds": {
        "asserts": [],
        "knowledge": [],
        "config": {}
      }
    }
  },
  "skeleton": {
    "spine": [
      "topic-analysis-report",
      "topic-proposal"
    ],
    "edges": [
      [
        "topic-analysis-report",
        "topic-proposal"
      ]
    ]
  },
  "caps": [
    "选题分析",
    "选题方案",
    "审美终审",
    "交付对账"
  ]
}
