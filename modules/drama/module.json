  "skeleton": { "spine": ["scene-breakdown"], "edges": [] },
  "caps": ["分集分镜"],
  "io": {
    "input": { "from": "plot", "shape": "剧本 IR（逐场 5W/行动/台词/价值/钩 + 伏笔登记）" },
    "output": { "file": "分镜剧本.md", "audience": "导演/制片（可拍摄分镜，导出可批注 docx）" },
    "acceptance": { "asserts": ["AE-BEAT-FORMAT", "AE-VIS-EMPTY", "AE-HOOK-EVENT"] }
