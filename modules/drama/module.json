{
  "format": "module@1",
  "id": "drama",
  "name": "成剧",
  "desc": "成剧域：剧本 IR → B拍分集分镜剧本（可拍摄/可导出/可批注的短剧剧本）",
  "version": "0.1.0",
  "ops": {
    "scene-breakdown": {
      "skill": "scene-breakdown",
      "title": "小纲师·分镜脚本",
      "desc": "剧本 IR → 逐集 B拍分镜剧本（第X集/拍号｜钩型｜秒/分镜/台词/表演/尾钩），短剧模块唯一交付件",
      "kind": "produce",
      "output": "分镜剧本.md",
      "knowledge": [
        "kb/aesthetic/character",
        "kb/aesthetic/dialogue",
        "kb/aesthetic/hook-3s",
        "kb/aesthetic/pacing-density",
        "kb/aesthetic/scene-value",
        "kb/method/longform-engineering"
      ],
      "capability": [
        "分集分镜"
      ],
      "config": {
        "shotsPerScene": {
          "type": "number",
          "default": 3,
          "desc": "每场拍数下限",
          "effect": "改了 = 节奏颗粒度变化",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "dialogLevel": {
          "type": "enum",
          "default": "标准",
          "enum": [
            "精简",
            "标准",
            "加密"
          ],
          "desc": "台词密度档位",
          "effect": "改了 = 单集信息量变化",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "model_tier": {
          "type": "enum",
          "enum": [
            "high",
            "lite"
          ],
          "default": "high",
          "desc": "执行档位：high=强模型（文学/结构判断），未声明=不约束",
          "effect": "文学与结构判断节点必须 high；机械整理类可降 lite",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "maxChars": {
          "type": "number",
          "min": 200,
          "max": 40000,
          "default": 12000,
          "unit": "字",
          "desc": "正文篇幅目标：写到接近 12000 字（下限按 80% 执行≈9600 字）；超出视为未收敛",
          "effect": "唯一交付件，甲方按此批注（厚度主战场）",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      },
      "also_fits": [],
      "requires": [],
      "adds": {
        "knowledge": [],
        "config": {}
      }
    },
    "render-prompt-seedance": {
      "skill": "render-prompt-seedance",
      "title": "Seedance 分镜提示词",
      "desc": "AI 生成视频的画面调度指令：@素材点名定岗/固定运镜词库/分时段描述/角色一致性锁图。",
      "kind": "produce",
      "knowledge": [
        "kb/aesthetic/visual-poster",
        "kb/deconstruct/style-learning"
      ],
      "minitools": [
        "scan_quality"
      ],
      "config": {
        "shotSec": {
          "type": "number",
          "default": 5,
          "min": 0,
          "desc": "单镜头时长（秒）",
          "effect": "提高 = 镜头更少更慢",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "cameraLock": {
          "type": "enum",
          "default": "固定词库",
          "enum": [
            "固定词库",
            "自由"
          ],
          "desc": "运镜词来源",
          "effect": "自由 = 模型理解不稳",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "consistencyLock": {
          "type": "enum",
          "default": "锁图",
          "enum": [
            "锁图",
            "锁描述"
          ],
          "desc": "跨镜头一致性的锁定方式",
          "effect": "锁描述 = 省图但漂移更快",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      },
      "capability": [
        "视频提示词"
      ],
      "slot": "after:script-final",
      "also_fits": [
        "end"
      ],
      "requires": [],
      "adds": {
        "knowledge": [],
        "config": {}
      }
    }
  },
  "skeleton": {
    "spine": [
      "scene-breakdown"
    ],
    "edges": []
  },
  "caps": [
    "分集分镜"
  ],
  "io": {
    "input": {
      "from": "plot",
      "shape": "剧本 IR（逐场 5W/行动/台词/价值/钩 + 伏笔登记）"
    },
    "output": {
      "file": "分镜剧本.md",
      "audience": "导演/制片（可拍摄分镜，导出可批注 docx）"
    }
  }
}
