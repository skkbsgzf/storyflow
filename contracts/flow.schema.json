{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "miniflow/flow",
  "title": "flow@3 · 模块序列流程",
  "description": "flows/<id>/flow.json。flow 不再手写节点与边——只写「模块序列」：走哪几个模块、每个模块要什么能力（caps）、模块之间怎么放行（link）。节点与边由内核 modules.ts::expandFlow 从 module@1 骨架派生（R6 规范 §二/§三）。取代 flow@2（graph/stages 手画形态废弃，一次性转换见 tools/flow-v3-migrate.py）。设计源：docs/规范-模块化flow与工具箱-R6.md。",
  "type": "object",
  "required": ["format", "id", "title", "version", "status", "modules"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "flow@3" },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "流程 id，即 flows/<id>/ 目录名"
    },
    "title": { "type": "string" },
    "desc": { "type": "string" },
    "version": { "type": "string" },
    "status": {
      "enum": ["draft", "official", "retired"],
      "description": "draft=草稿 / official=官方发布（商店可装）/ retired=退役"
    },
    "inputs": {
      "type": "object",
      "description": "流程输入契约（开跑前由项目配置/CLI 装载）。键名 = 输入名",
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "enum": ["project", "string", "number", "boolean", "enum"] },
          "required": { "type": "boolean" },
          "default": {},
          "desc": { "type": "string" },
          "options": { "type": "array", "description": "type=enum 的取值表" },
          "bind": {
            "type": "object",
            "description": "输入绑定到模块级条件（R6 保留模块级 when）",
            "properties": {
              "edge": { "type": "string", "description": "受控边 id" },
              "module": { "type": "string", "description": "受控模块实例 id" }
            }
          }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "link": {
          "enum": ["auto", "manual"],
          "description": "模块实例未显式声明 link 时的缺省连接模式"
        }
      }
    },
    "policy": {
      "type": "object",
      "description": "R6 简化：旧 kit_boundary / gate_mode 退役，运行时策略只剩 link_default（默认连接模式）+ 优化器口径（adapt）+ 预算（budget）",
      "additionalProperties": false,
      "properties": {
        "link_default": {
          "enum": ["auto", "manual"],
          "description": "全局缺省连接模式；优先级 = 模块实例 link > defaults.link > policy.link_default"
        },
        "adapt": {
          "enum": ["off", "propose", "apply"],
          "description": "优化器权限：off=只观测 / propose=只出提案 / apply=低风险自动落地（R5 口径沿用）"
        },
        "budget": {
          "type": "object",
          "description": "成本预算（tokens/时延上限等），优化器超支预警用",
          "additionalProperties": true
        }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "description": "模块序列 = 流程本体。顺序即执行顺序；相邻实例之间由内核铸一个连接件节点 <实例id>.link",
      "items": {
        "type": "object",
        "required": ["id", "module"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "模块实例 id（全 flow 唯一、稳定）；派生节点 id 前缀 <实例id>.<tool>，连接件为 <实例id>.link"
          },
          "module": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "引用 modules/<id>/module.json"
          },
          "link": {
            "enum": ["auto", "manual"],
            "description": "进入本模块的连接件模式；缺省取 defaults.link，再缺省取 policy.link_default"
          },
          "caps": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string" },
            "description": "想要的能力集合（人类词，须 ⊆ 目标模块 caps）；缺省 = 骨架自带能力。写「伏笔」而不是 foreshadow-plant"
          },
          "insert": {
            "type": "object",
            "description": "显式把 tool 钉到插槽：{\"<slot>\": [\"<tool>\", …]}。slot/tool 必须存在于目标模块（flow-lint 校验）",
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
            }
          },
          "iterate": {
            "type": "object",
            "description": "按单位重复执行（如按章/卷/集推进写作模块）",
            "additionalProperties": false,
            "properties": {
              "unit": { "enum": ["chapter", "volume", "episode"], "description": "重复单位：章 / 卷 / 集" },
              "over": { "type": "string", "description": "单位来源（上游产物字段名，如 卷纲 / 分集功能表）" },
              "first": { "type": "integer", "minimum": 1, "description": "起始单位序号（如 first:1 从第 1 章起）" }
            }
          },
          "vary": {
            "type": "object",
            "description": "逐单位差异：{\"<单位序号>\": {caps:[…], insert:{…}}}（如第 13 章加伏笔回收能力）",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "caps": { "type": "array", "items": { "type": "string" } },
                "insert": {
                  "type": "object",
                  "additionalProperties": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          },
          "when": {
            "type": "string",
            "description": "模块级可选开关条件（绑定 inputs，如 题材类型）；节点级 when 已取消（模块内是线性骨架，无分支）"
          }
        }
      }
    },
    "outputs": {
      "type": "array",
      "description": "流程交付出口：声明哪个模块实例产出什么交付物（R6 改 outputs[].node → outputs[].module；不再指向节点）",
      "items": {
        "type": "object",
        "required": ["module", "title"],
        "additionalProperties": false,
        "properties": {
          "module": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "产出该交付物的模块实例 id（须存在于 modules[]）"
          },
          "title": { "type": "string", "description": "交付物名（如 前三章终稿）" },
          "audience": { "type": "string", "description": "受众（如 平台编辑 / 甲方）" }
        }
      }
    },
    "changelog": {
      "type": "array",
      "description": "版本记录 [{version, date, changes[]}]",
      "items": {
        "type": "object",
        "properties": {
          "version": { "type": "string" },
          "date": { "type": "string" },
          "changes": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
