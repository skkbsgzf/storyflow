    "layer-voices": {
      "skill": "layer-voices",
      "title": "layer-voices",
      "desc": "成文流水线专科层一——从分场卡逐拍产出对白层稿：每句台词标注说话人/目的/潜台词，全员过遮名三句测试；只管台词，不写叙述。",
      "model_tier": "high",
      "knowledge": [
        "kb/aesthetic/character",
        "kb/aesthetic/dialogue",
        "kb/craft/prose-constraints",
        "kb/craft/user-style-rules",
        "kb/craft/highlight-loop"
