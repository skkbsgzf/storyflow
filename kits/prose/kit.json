            "说话人",
            "说话人+目的",
            "说话人+目的+潜台词"
          ],
          "desc": "每句台词的标注字段",
          "effect": "只标说话人 = 上下文不足",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      }
    },
    "novel-chapter": {
