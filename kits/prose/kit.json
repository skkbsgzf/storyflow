{
  "format": "kit@1",
  "id": "prose",
  "domain": "prose",
  "name": "prose kit",
  "desc": "文学域：层稿/成文/逐段盖章/去AI味/评审——文学质量内置在流水线",
  "version": "0.1.0",
  "ops": {
    "dialogue-polish": {
      "skill": "dialogue-polish",
      "title": "dialogue-polish",
      "desc": "剧本强制末环节技能——全部人物对话逐句过三遍：人物声口校准（遮名可辨+说话习惯一致）、处境校准（压力与关系下的语言变化）、去AI味清单（24类+结构指纹）；基于人物和处境优化，不做通用润色。",
      "model_tier": "high",
      "knowledge": [
        "kb/aesthetic/ai-trace",
        "kb/aesthetic/character",
        "kb/aesthetic/dialogue",
        "kb/aesthetic/naturalness-zh"
      ],
      "minitools": [
        "check_aesthetic_asserts"
      ],
      "config": {
        "passes": {
          "type": "number",
          "default": 3,
          "min": 0,
          "desc": "逐句过的遍数（声口/处境/去AI味）",
          "effect": "降低 = 省成本但机味残留",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "maskTest": {
          "type": "boolean",
          "default": true,
          "desc": "遮名三句测试（遮住名字能认出谁说话）",
          "effect": "关掉 = 人物声口趋同",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "aiTraceDeck": {
          "type": "enum",
          "default": "24类",
          "enum": [
            "精简",
            "24类"
          ],
          "desc": "去AI味清单的档位",
          "effect": "精简 = 只查高频类，漏检增加",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "preserveVoice": {
          "type": "boolean",
          "default": true,
          "desc": "保留作者原有节奏不改成标准腔",
          "effect": "关掉 = 全部对话变成同一种腔调",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      }
    },
    "layer-canon": {
      "skill": "layer-canon",
      "title": "layer-canon",
      "desc": "成文流水线专科层三——从分场卡逐拍产出设定层稿：知情范围切片、新词首现方案、台账增量、人设矛盾提示；只管世界观一致性与读者认知边界，不碰文笔。",
      "knowledge": [
        "kb/aesthetic/character",
        "kb/continuity/state-ledger",
        "kb/continuity/worldbook",
        "kb/craft/prose-constraints",
        "kb/craft/user-style-rules"
      ],
      "minitools": [
        "continuity_check"
      ],
      "config": {
        "sliceUnit": {
          "type": "enum",
          "default": "按拍",
          "enum": [
            "按章",
            "按拍"
          ],
          "desc": "知情范围切片粒度",
          "effect": "按章 = 更省，越权漏检率上升",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "newWordPolicy": {
          "type": "enum",
          "default": "首现即注",
          "enum": [
            "首现即注",
            "延后注"
          ],
          "desc": "新词第一次出现的处理",
          "effect": "延后注 = 前几章读者发懵",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "ledgerDiff": {
          "type": "boolean",
          "default": true,
          "desc": "输出台账增量",
          "effect": "关掉 = 设定层与台账脱钩",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      }
    },
    "layer-scenes": {
      "skill": "layer-scenes",
      "title": "layer-scenes",
