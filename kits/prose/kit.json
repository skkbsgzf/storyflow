        "maskTest": {
          "type": "boolean",
          "default": true,
          "desc": "全员过遮名三句测试",
          "effect": "关掉 = 声口靠读者脑补",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "perLineTag": {
          "type": "enum",
          "default": "说话人+目的+潜台词",
