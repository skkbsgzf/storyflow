            "均一",
            "随情绪波动"
          ],
          "desc": "笔墨密度的配比方式",
          "effect": "均一 = 读起来像说明书",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "propsDepth": {
          "type": "enum",
          "default": "陈列",
          "enum": [
            "点到",
            "陈列",
            "考据"
          ],
          "desc": "道具与布景的考据深度",
          "effect": "点到 = 快；考据 = 沉",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      }
