{
  "format": "kit@1",
  "id": "search",
  "domain": "search",
  "name": "search kit",
  "desc": "检索取数域：市场盘面/梗库/素材/热点 → 结构化素材与选题方案",
  "version": "0.1.0",
  "ops": {
    "deconstruct-book": {
      "skill": "deconstruct-book",
      "title": "deconstruct-book",
      "desc": "拆书技能——按拆书总协议把参考作品拆成六槽位可入库素材（梗/人设/剧情设计/导语/细化/片段），产出带替换变量与使用条件的 KB 候选条目；溯源纪律全程硬约束。",
      "knowledge": [
        "kb/aesthetic/character",
        "kb/aesthetic/pacing-density",
        "kb/deconstruct/protocol",
        "kb/deconstruct/style-learning"
      ],
      "minitools": [
        "kb_search",
        "check_trope_combo"
      ],
      "config": {
        "slots": {
          "type": "number",
          "default": 6,
          "min": 0,
          "desc": "入库槽位数（梗/人设/剧情设计/导语/细化/片段）",
          "effect": "减少 = 拆书产出不完整",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "variableReplace": {
          "type": "boolean",
          "default": true,
          "desc": "产出带替换变量的模板条目",
          "effect": "关掉 = 素材不可复用",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "traceability": {
          "type": "enum",
          "default": "逐条溯源",
          "enum": [
            "逐条溯源",
            "抽样"
          ],
          "desc": "溯源纪律强度",
          "effect": "抽样 = 快但没法追责",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      }
    },
    "find-trope": {
      "skill": "find-trope",
      "title": "find-trope",
      "desc": "找梗技能——从市场梗库检索梗族、判定饱和度、选主梗辅梗、沿演化链找新变体落点；梗卡是选题方案的前置件。",
      "knowledge": [
        "kb/market/snapshot",
        "kb/market/structure",
        "kb/trope/*"
      ],
      "exclude_knowledge": [
        "kb/trope/na-billionaire",
        "kb/trope/na-fantasy",
        "kb/trope/na-werewolf"
      ],
      "minitools": [
        "kb_search",
        "check_trope_combo"
      ],
      "config": {
        "mainTropes": {
          "type": "number",
          "default": 1,
          "min": 0,
          "desc": "主梗数量",
          "effect": "提高 = 焦点散",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "subTropes": {
          "type": "number",
          "default": 3,
          "min": 0,
          "desc": "辅梗数量",
          "effect": "提高 = 组合更新鲜也更难落实",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "saturationCheck": {
          "type": "boolean",
          "default": true,
          "desc": "判定梗族饱和度",
          "effect": "关掉 = 选到烂梗",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "evolutionDepth": {
          "type": "enum",
          "default": "两代",
          "enum": [
            "一代",
            "两代",
            "链式"
          ],
          "desc": "沿演化链向上找的代数",
          "effect": "越深越新、越难写",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      }
    },
    "internet-feel": {
      "skill": "internet-feel",
      "title": "internet-feel",
      "desc": "网感技能——按市场公式产标题、一句话卖点、共情点与所有对外文案；每个字都在传递钩子或爽点，产出过 24 类去模板化自检。",
      "knowledge": [
        "kb/aesthetic/hook-3s",
        "kb/aesthetic/naturalness-zh",
        "kb/market/internet-feel"
      ],
      "minitools": [
        "check_aesthetic_asserts"
      ],
      "config": {
        "titleCount": {
          "type": "number",
          "default": 10,
          "min": 0,
          "desc": "标题候选数",
          "effect": "提高 = 命中率上升、成本线性上升",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "formulaDeck": {
          "type": "enum",
          "default": "市场公式",
          "enum": [
            "市场公式",
            "自创"
          ],
          "desc": "文案公式来源",
          "effect": "自创 = 不稳定",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "templateCheck": {
          "type": "enum",
          "default": "24类",
          "enum": [
            "精简",
            "24类"
          ],
          "desc": "去模板化自检档位",
          "effect": "精简 = 漏检增加",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      }
    },
    "material-dissect": {
      "skill": "material-dissect",
      "title": "material-dissect",
      "desc": "选题素材解剖技能——申论式四层剥离（现象/利益/权力/结构），把热点事件聚合成关系结构与权力不对称，从关系逆位生成爽点候选，产出材料落位表。素材不解剖=假材料，梗不落位=装饰品。",
      "knowledge": [
        "kb/market/meme-rules",
        "kb/market/topic-anatomy"
      ],
      "config": {
        "layers": {
          "type": "number",
          "default": 4,
          "min": 0,
          "desc": "申论式剥离层数（现象/利益/权力/结构）",
          "effect": "减少 = 素材停在表面",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "inversionCount": {
          "type": "number",
          "default": 3,
          "min": 0,
          "desc": "关系逆位生成的爽点候选数",
          "effect": "提高 = 候选更多、筛选成本上升",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "placement": {
          "type": "enum",
          "default": "落位表",
          "enum": [
            "落位表",
            "散点"
          ],
          "desc": "素材落位方式",
          "effect": "散点 = 素材与结构脱钩",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      }
    },
    "topic-analysis-report": {
      "skill": "topic-analysis-report",
      "title": "选题分析报告方法论",
      "desc": "选题流程·分析报告步的工作规范——消费选题素材包与四视角评估批注，产出市场/目标客群/竞品/数据分析四板块加结论的选题分析报告，并以「创作约束移交单」向编剧步移交硬约束。",
      "knowledge": [
        "kb/aesthetic/oversight",
        "kb/market/*",
        "kb/structure/episodic-webnovel"
      ],
      "assist": [
        "internet-feel"
      ],
      "config": {
        "sections": {
          "type": "number",
          "default": 4,
          "min": 0,
          "desc": "报告板块数（市场/客群/竞品/数据）",
          "effect": "减少 = 分析不完整",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "handoffSheet": {
          "type": "boolean",
          "default": true,
          "desc": "输出创作约束移交单",
          "effect": "关掉 = 编剧步没硬约束",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "dataCitations": {
          "type": "number",
          "default": 5,
          "min": 0,
          "desc": "引用数据的条数下限",
          "effect": "降低 = 结论悬浮",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      }
    },
    "topic-chief-aesthetic": {
      "skill": "topic-chief-aesthetic",
      "title": "审美总编·选题方案质量观",
      "desc": "审美总编技能（监管位）——以对标已出品爆款为强度标尺，对选题方案做爆点强度/钩子冲击力/名场面可视化三维把控；写入方案即视为总编终审通过。",
      "config": {
        "benchmark": {
          "type": "enum",
          "default": "对标爆款",
          "enum": [
            "对标爆款",
            "内部标准"
          ],
          "desc": "强度标尺来源",
          "effect": "内部标准 = 与市场脱节",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "dims": {
          "type": "number",
          "default": 3,
          "min": 0,
          "desc": "把控维度数（爆点强度/钩子冲击力/名场面可视化）",
          "effect": "减少 = 把控漏面",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "writeInto": {
          "type": "boolean",
          "default": true,
          "desc": "把控结论直接写入方案（视为终审通过）",
          "effect": "关掉 = 把控意见游离在方案外",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      }
    },
    "topic-delivery-gate": {
      "skill": "topic-delivery-gate",
      "title": "需求交付·对账清单",
      "desc": "需求交付技能（监管位）——对分析报告「创作约束移交单」逐条合规对账 + 交付完整性核查；硬条款违反一票否决，合同优先于审美。",
      "config": {
        "checklist": {
          "type": "enum",
          "default": "逐条对账",
          "enum": [
            "逐条对账",
            "抽样"
          ],
          "desc": "对「创作约束移交单」的核查方式",
          "effect": "抽样 = 硬条款可能漏",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "vetoHard": {
          "type": "boolean",
          "default": true,
          "desc": "硬条款违反一票否决",
          "effect": "关掉 = 合同风险自担",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      }
    },
    "topic-proposal": {
      "skill": "topic-proposal",
      "title": "选题方案方法论",
      "desc": "选题流程·选题方案步的工作规范——纯内容呈现：选题、人设、冲突设计、大纲、前三集初稿；市场结论只以「创作约束移交单」为输入，报告里禁止商业分析语言。",
      "knowledge": [
        "kb/aesthetic/*",
        "kb/benchmark/*"
      ],
      "assist": [
        "internet-feel",
        "plot-choreographer"
      ],
      "config": {
        "outlineDepth": {
          "type": "enum",
          "default": "粗纲",
          "enum": [
            "粗纲",
            "细纲"
          ],
          "desc": "大纲的颗粒度",
          "effect": "细纲 = 更快进入成稿也更贵",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "firstEpisodes": {
          "type": "number",
          "default": 3,
          "min": 0,
          "desc": "前三集初稿的集数",
          "effect": "提高 = 交付更重",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "banBizLanguage": {
          "type": "boolean",
          "default": true,
          "desc": "禁止出现商业分析语言",
          "effect": "关掉 = 方案串味",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      }
    },
    "topic-zeitgeist": {
      "skill": "topic-zeitgeist",
      "title": "时代情绪锚",
      "desc": "主旋律与实时性技能——选题必须锚定一个近 30 天可举证的社会情绪，故事是该情绪的具象化；无锚点的选题是经典母题复读，缺共鸣乘数。",
      "config": {
        "windowDays": {
          "type": "number",
          "default": 30,
          "min": 0,
          "desc": "情绪锚点的可举证时间窗（天）",
          "effect": "放宽 = 更容易凑数也更平庸",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "evidenceCount": {
          "type": "number",
          "default": 3,
          "min": 0,
          "desc": "锚点需要的举证条数",
          "effect": "降低 = 锚点是拍脑袋",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        },
        "emotionAnchors": {
          "type": "number",
          "default": 1,
          "min": 0,
          "desc": "锚定的社会情绪数",
          "effect": "提高 = 故事要兼顾的情绪更多",
          "tunable_by": [
            "user",
            "optimizer"
          ]
        }
      }
    }
  }
}
